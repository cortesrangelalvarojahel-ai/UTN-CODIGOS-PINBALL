/*
 * PINBALL - INTEGRACIÓN SEMANA 6 (CÓDIGO COMPLETO - MODO SIMULACIÓN OPTIMIZADO)
 * * MAPA DE PINES AJUSTADO:
 * - Botón Verde (Moneda $1 con Anti-Pesca) -> PIN 4
 * - Botón Rojo (Sensor Gabinete / Intrusión) -> PIN 19 [MODO TOGGLE]
 * - LED / Actuador Hopper (Motor)           -> PIN 23
 * - Pantalla OLED (I2C)                     -> SDA: 21, SCL: 22
 * * Validación del Hopper: Automatizada por software para liberar el Pin 19.
 */

#include <Arduino.h>
#include <Wire.h> 

// --- CONFIGURACIÓN DE PINES ---
const int PIN_MONEDA = 4;           // Botón Verde
const int PIN_GABINETE = 19;        // Botón Rojo: Sensor de Intrusión (Gabinete Abierto)
const int PIN_HOPPER_MOTOR = 23;    // LED Azul: Representa el motor del Hopper

// --- PARÁMETROS DE SEGURIDAD ---
const unsigned long T_MIN_PULSO = 20;    
const unsigned long T_MAX_PULSO = 150;   
const unsigned long T_INTERVALO = 100;   

// --- VARIABLES VOLÁTILES (SECURITY ENGINE) ---
volatile bool monedaDetectada = false;
volatile bool posiblePesca = false;
volatile unsigned long ultimoPulsoValido = 0;
volatile unsigned long ultimaDuracion = 0;

// --- VARIABLES DE CONTROL NO BLOQUEANTE ---
int totalEntregadoHistorico = 0; 
bool esperandoValidacionHopper = false; 
String statusSeguridad = "CLEAN"; // CLEAN, FRAUD_DETECTED, INTRUSION_DETECTED

unsigned long tiempoInicioPago = 0;
const unsigned long TIEMPO_GIRO_HOPPER = 800; // Tiempo en ms que gira el motor

unsigned long tiempoInicioBloqueo = 0;
const unsigned long DURACION_BLOQUEO = 3000; 

// --- FUNCIÓN DE INTERRUPCIÓN OPTIMIZADA ---
void IRAM_ATTR verificarMonedaISR() {
    unsigned long t_actual = millis();
    
    // Si el gabinete está abierto o hay fraude activo, se ignoran por completo las monedas
    if (esperandoValidacionHopper || statusSeguridad != "CLEAN") return;

    if (t_actual - ultimoPulsoValido < T_INTERVALO) {
        ultimaDuracion = t_actual - ultimoPulsoValido;
        posiblePesca = true; 
        return;
    }

    unsigned long duracionSimulada = 40; 
    ultimaDuracion = duracionSimulada;

    if (duracionSimulada > T_MAX_PULSO) {
        posiblePesca = true; 
    } 
    else if (duracionSimulada >= T_MIN_PULSO) {
        monedaDetectada = true;
        ultimoPulsoValido = t_actual;
    }
}

// --- REPORTE ESTRUCTURADO SERIAL ---
void imprimirReporteEstructurado(String evento) {
    Serial.println("\n=========================================");
    Serial.print("EVENTO: "); Serial.println(evento);
    Serial.println("-----------------------------------------");
    Serial.print(" -> TOTAL EN CAJA HISTÓRICO: $"); Serial.println(totalEntregadoHistorico);
    Serial.print(" -> Estado del Hopper Motor:  "); Serial.println(digitalRead(PIN_HOPPER_MOTOR) == HIGH ? "ENCENDIDO" : "APAGADO");
    Serial.print(" -> Security Engine Status:   "); Serial.println(statusSeguridad);
    Serial.print(" -> Último Pulso Medido:      "); Serial.print(ultimaDuracion); Serial.println(" ms");
    Serial.println("=========================================");
}

void setup() {
    Serial.begin(115200);
    
    pinMode(PIN_MONEDA, INPUT_PULLUP);
    pinMode(PIN_GABINETE, INPUT_PULLUP); // Configurado con Pull-Up interna para el botón rojo
    
    pinMode(PIN_HOPPER_MOTOR, OUTPUT);
    digitalWrite(PIN_HOPPER_MOTOR, LOW); 

    Wire.begin(21, 22); 
    
    attachInterrupt(digitalPinToInterrupt(PIN_MONEDA), verificarMonedaISR, FALLING);
    
    Serial.println("--- Sistema Pinball Inicializado (Semana 6: Completo con Toggle) ---");
    imprimirReporteEstructurado("SISTEMA_REINICIADO");
}

void loop() {
    unsigned long tiempoActual = millis();

    // 1. MONITOREO DE INTRUSIÓN (BOTÓN ROJO EN PIN 19 - MODO ALTERNABLE / TOGGLE)
    int estadoActualGabinete = digitalRead(PIN_GABINETE);
    static int estadoAnteriorGabinete = HIGH;
    static unsigned long tiempoUltimoCambioGabinete = 0;

    // Detectamos el flanco de bajada (cuando haces clic en Wokwi: cambia de HIGH a LOW)
    if (estadoActualGabinete == LOW && estadoAnteriorGabinete == HIGH) {
        if (tiempoActual - tiempoUltimoCambioGabinete > 300) { // Filtro antirrebote por software
            
            if (statusSeguridad != "INTRUSION_DETECTED") {
                statusSeguridad = "INTRUSION_DETECTED";
                digitalWrite(PIN_HOPPER_MOTOR, LOW); // Apagado inmediato de seguridad (Inhibición)
                esperandoValidacionHopper = false;
                imprimirReporteEstructurado("ALERTA_GABINETE_ABIERTO");
            } else {
                statusSeguridad = "CLEAN";
                monedaDetectada = false; // Limpia cualquier disparo accidental
                imprimirReporteEstructurado("GABINETE_CERRADO_MONITOREO_REESTABLECIDO");
            }
            
            tiempoUltimoCambioGabinete = tiempoActual;
        }
    }
    estadoAnteriorGabinete = estadoActualGabinete;

    // El resto de la lógica operativa solo se ejecuta si el gabinete está cerrado ("CLEAN")
    if (statusSeguridad != "INTRUSION_DETECTED") {
        
        // 2. GESTIÓN DE MONEDA LEGÍTIMA
        if (monedaDetectada) {
            monedaDetectada = false; 
            esperandoValidacionHopper = true; 
            tiempoInicioPago = tiempoActual; 
            
            digitalWrite(PIN_HOPPER_MOTOR, HIGH); 
            imprimirReporteEstructurado("MONEDA_DETECTADA_MOTOR_ENCENDIDO");
        }

        // 3. VALIDACIÓN TEMPORAL DE EGRESO (Automatizada por software con millis)
        if (esperandoValidacionHopper) {
            if (tiempoActual - tiempoInicioPago >= TIEMPO_GIRO_HOPPER) {
                digitalWrite(PIN_HOPPER_MOTOR, LOW); // Apaga el motor
                totalEntregadoHistorico += 1;        // Incrementa acumulador histórico
                esperandoValidacionHopper = false;   
                
                imprimirReporteEstructurado("PAGO_Y_ENTREGA_VALIDADA_POR_SOFTWARE");
            }
        }

        // 4. DETECCIÓN DE FRAUDE (Anti-Pesca de la Semana 5)
        if (posiblePesca && statusSeguridad != "FRAUD_DETECTED") {
            posiblePesca = false;
            statusSeguridad = "FRAUD_DETECTED"; 
            
            digitalWrite(PIN_HOPPER_MOTOR, LOW); 
            esperandoValidacionHopper = false;
            tiempoInicioBloqueo = tiempoActual;  
            
            imprimirReporteEstructurado("ALERTA_FRAUDE");
        }

        // Control del desbloqueo por tiempo para el fraude
        if (statusSeguridad == "FRAUD_DETECTED") {
            if (tiempoActual - tiempoInicioBloqueo >= DURACION_BLOQUEO) {
                statusSeguridad = "CLEAN";
                posiblePesca = false;
                monedaDetectada = false;
                Serial.println("\n[SECURITY ENGINE]: Penalización terminada de forma fluida. Reiniciando monitoreo...");
            }
        }
    }
}
