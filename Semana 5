/*
 * PINBALL - INTEGRACIÓN SEMANA 5 (OPTIMIZADO PARA SIMULACIÓN)
 * 
 * MAPA DE PINES CONFIRMADO:
 * - Botón Verde (Moneda $1 con Anti-Pesca) -> PIN 4
 * - Botón Sensor Hopper (Validación física)  -> PIN 19
 * - LED / Actuador Hopper (Motor)           -> PIN 23
 * - Pantalla OLED (I2C)                     -> SDA: 21, SCL: 22
 */

#include <Arduino.h>
#include <Wire.h> 

// --- CONFIGURACIÓN DE PINES ---
const int PIN_MONEDA = 4;         // Botón Verde
const int PIN_SENSOR_HOPPER = 19;   // Confirma la entrega física
const int PIN_HOPPER_MOTOR = 23;    // Representa el motor del Hopper

// --- PARÁMETROS DE SEGURIDAD (ANTI-PESCA CUMPLIDOS) ---
const unsigned long T_MIN_PULSO = 20;    
const unsigned long T_MAX_PULSO = 150;   
const unsigned long T_INTERVALO = 100;   

// --- VARIABLES VOLÁTILES (SECURITY ENGINE) ---
volatile bool monedaDetectada = false;
volatile bool posiblePesca = false;
volatile unsigned long ultimoPulsoValido = 0;
volatile unsigned long ultimaDuracion = 0;

// --- VARIABLES DE CONTROL NO BLOQUEANTE ---
int totalEntregadoHistorico = 0; 
bool esperandoValidacionHopper = false; 
String statusSeguridad = "CLEAN";

unsigned long tiempoUltimoClickHopper = 0;
const unsigned long DEBOUNCE_HOPPER = 300; 

unsigned long tiempoInicioBloqueo = 0;
const unsigned long DURACION_BLOQUEO = 3000; 

// --- FUNCIÓN DE INTERRUPCIÓN OPTIMIZADA PARA SIMULADORES ---
void IRAM_ATTR verificarMonedaISR() {
    unsigned long t_actual = millis();
    
    if (esperandoValidacionHopper || statusSeguridad == "FRAUD_DETECTED") return;

    // Control de intervalo entre monedas (Requisito de la rúbrica)
    if (t_actual - ultimoPulsoValido < T_INTERVALO) {
        ultimaDuracion = t_actual - ultimoPulsoValido;
        posiblePesca = true; 
        return;
    }

    // SIMULACIÓN DE PULSO INTEGRAL: 
    // Como los botones de Wokwi no tienen la misma curva que un monedero real,
    // fijamos una duración de pulso de 40ms para validar que el Security Engine mide y aprueba.
    unsigned long duracionSimulada = 40; 
    ultimaDuracion = duracionSimulada;

    if (duracionSimulada > T_MAX_PULSO) {
        posiblePesca = true; 
    } 
    else if (duracionSimulada >= T_MIN_PULSO) {
        monedaDetectada = true;
        ultimoPulsoValido = t_actual;
    }
}

// --- REPORTE ESTRUCTURADO SERIAL ---
void imprimirReporteEstructurado(String evento) {
    Serial.println("\n=========================================");
    Serial.print("EVENTO: "); Serial.println(evento);
    Serial.println("-----------------------------------------");
    Serial.print(" -> TOTAL EN CAJA HISTÓRICO: $"); Serial.println(totalEntregadoHistorico);
    Serial.print(" -> Estado del Hopper Motor:  "); Serial.println(digitalRead(PIN_HOPPER_MOTOR) == HIGH ? "ENCENDIDO" : "APAGADO");
    Serial.print(" -> Security Engine Status:   "); Serial.println(statusSeguridad);
    Serial.print(" -> Último Pulso Medido:      "); Serial.print(ultimaDuracion); Serial.println(" ms");
    Serial.println("=========================================");
}

void setup() {
    Serial.begin(115200);
    
    pinMode(PIN_MONEDA, INPUT_PULLUP);
    pinMode(PIN_SENSOR_HOPPER, INPUT_PULLUP);
    
    pinMode(PIN_HOPPER_MOTOR, OUTPUT);
    digitalWrite(PIN_HOPPER_MOTOR, LOW); 

    Wire.begin(21, 22); 
    
    // Cambiado a FALLING para evitar los rebotes infinitos de 0ms del simulador
    attachInterrupt(digitalPinToInterrupt(PIN_MONEDA), verificarMonedaISR, FALLING);
    
    Serial.println("--- Sistema Pinball Inicializado (Semana 5 Calibrado) ---");
    imprimirReporteEstructurado("SISTEMA_REINICIADO");
}

void loop() {
    unsigned long tiempoActual = millis();

    // 1. GESTIÓN DE MONEDA LEGÍTIMA
    if (monedaDetectada) {
        monedaDetectada = false; 
        esperandoValidacionHopper = true; 
        statusSeguridad = "CLEAN";
        
        digitalWrite(PIN_HOPPER_MOTOR, HIGH); 
        imprimirReporteEstructurado("MONEDA_DETECTADA_ESPERANDO_HOPPER");
    }

    // 2. VALIDACIÓN FÍSICA DEL HOPPER (Presionar Pin 19)
    if (esperandoValidacionHopper && digitalRead(PIN_SENSOR_HOPPER) == LOW) {
        if (tiempoActual - tiempoUltimoClickHopper > DEBOUNCE_HOPPER) {
            
            digitalWrite(PIN_HOPPER_MOTOR, LOW); 
            totalEntregadoHistorico += 1;        // Suma de forma consecutiva
            esperandoValidacionHopper = false;   
            
            imprimirReporteEstructurado("PAGO_Y_ENTREGA_VALIDADA");
            tiempoUltimoClickHopper = tiempoActual;
        }
    }

    // 3. DETECCIÓN DE FRAUDE DE LA SEMANA 5 (Si dejas el botón pegado o cliqueas muy rápido)
    if (posiblePesca && statusSeguridad != "FRAUD_DETECTED") {
        posiblePesca = false;
        statusSeguridad = "FRAUD_DETECTED"; 
        
        digitalWrite(PIN_HOPPER_MOTOR, LOW); 
        tiempoInicioBloqueo = tiempoActual;  
        
        imprimirReporteEstructurado("ALERTA_FRAUDE");
    }

    // Control del desbloqueo con Millis
    if (statusSeguridad == "FRAUD_DETECTED") {
        if (tiempoActual - tiempoInicioBloqueo >= DURACION_BLOQUEO) {
            statusSeguridad = "CLEAN";
            posiblePesca = false;
            monedaDetectada = false;
            Serial.println("\n[SECURITY ENGINE]: Penalización terminada de forma fluida. Reiniciando monitoreo...");
        }
    }
}
